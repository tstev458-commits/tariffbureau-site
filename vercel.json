{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://cdn.weglot.com https://cdn1.weglot.com https://*.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.weglot.com https://cdn1.weglot.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tariffbureau.com https://www.tariffbureau.com https://api.anthropic.com https://formspree.io https://cdn.weglot.com https://*.weglot.com https://www.google-analytics.com https://region1.google-analytics.com https://cloudflareinsights.com https://cdn-cgi.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formspree.io;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/chat",              "dest": "/api/chat.js" },
    { "src": "/api/intake",            "dest": "/api/intake.js" },
    { "src": "/assessment",            "dest": "/assessment.html" },
    { "src": "/assessment-result",     "dest": "/assessment-result.html" },
    { "src": "/pricing",               "dest": "/pricing.html" },
    { "src": "/services",              "dest": "/services.html" },
    { "src": "/intake",                "dest": "/intake.html" },
    { "src": "/contact",               "dest": "/contact.html" },
    { "src": "/about",                 "dest": "/about.html" },
    { "src": "/privacy",               "dest": "/privacy.html" },
    { "src": "/thank-you",             "dest": "/thank-you.html" },
    { "src": "/terms",                 "dest": "/terms.html" },
    { "src": "/intake-smart",          "dest": "/intake-smart.html" },
    { "src": "/screening",             "dest": "/screening.html" },
    { "src": "/updates",               "dest": "/updates.html" },
    { "src": "/updates-data.json",     "dest": "/public/updates-data.json" },
    { "src": "/ieepa-refund-recovery", "dest": "/ieepa-refund-recovery.html" }
  ]
}
